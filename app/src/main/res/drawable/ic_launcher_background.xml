<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the iOS AppIcon backdrop (tia-hrms-brand/icon-1024.png,
     make_app_icon.swift) as a vector: a top-to-bottom navy to royal-blue gradient, a soft
     top-left sheen and a bottom vignette. The glyph lives in ic_launcher_foreground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0" android:color="#FF1B2A4F" />
                <item android:offset="0.25" android:color="#FF1E3A7F" />
                <item android:offset="0.55" android:color="#FF2046A9" />
                <item android:offset="0.8" android:color="#FF234DA8" />
                <item android:offset="1" android:color="#FF24529E" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- top-left sheen -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="28" android:centerY="20"
                android:gradientRadius="80">
                <item android:offset="0" android:color="#24FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
